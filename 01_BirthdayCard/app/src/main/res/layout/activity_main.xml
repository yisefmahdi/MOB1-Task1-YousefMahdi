<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- 1. Background Image -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/bg_description"
        android:scaleType="centerCrop"
        android:src="@drawable/birthday_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Night Mode Dimming Scrim Overlay (Transparent in Day Mode, Dark in Night Mode) -->
    <View
        android:id="@+id/viewNightOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/night_overlay_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Theme Toggle Button (Light/Dark Mode Switcher for Quick Testing) -->
    <ImageButton
        android:id="@+id/btnThemeToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_toggle_button"
        android:contentDescription="@string/toggle_theme_desc"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_theme_toggle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4. Birthday Greeting Text: Happy Birthday Feras! -->
    <TextView
        android:id="@+id/tvBirthdayGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:lineSpacingMultiplier="1.05"
        android:text="@string/happy_birthday_text"
        android:textAlignment="center"
        android:textColor="@color/greeting_text_color"
        android:textSize="58sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- 5. Sender Signature Text: From Yousef -->
    <TextView
        android:id="@+id/tvFromSignature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/from_signature_text"
        android:textAlignment="center"
        android:textColor="@color/signature_text_color"
        android:textSize="36sp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBirthdayGreeting" />

</androidx.constraintlayout.widget.ConstraintLayout>
