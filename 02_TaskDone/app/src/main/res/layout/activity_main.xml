<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".MainActivity">

    <!-- Theme Toggle Button (Light/Dark Mode Switcher) -->
    <ImageButton
        android:id="@+id/btnThemeToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_toggle_button"
        android:contentDescription="@string/toggle_theme_desc"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_theme_toggle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Centered Content Container -->
    <LinearLayout
        android:id="@+id/layoutTaskDoneContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Task Completed Circle Checkmark Image -->
        <ImageView
            android:id="@+id/ivTaskCompleted"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:contentDescription="@string/task_done_image_desc"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_task_completed" />

        <!-- 2. "All tasks completed" Heading -->
        <TextView
            android:id="@+id/tvAllTasksCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/all_tasks_completed"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="sans-serif-medium" />

        <!-- 3. "Nice work!" Subtitle -->
        <TextView
            android:id="@+id/tvNiceWork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nice_work"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:fontFamily="sans-serif" />

        <!-- 4. Student Name: "Yousef Mahdi" -->
        <TextView
            android:id="@+id/tvStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/student_name"
            android:textColor="@color/student_name_color"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
